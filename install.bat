@echo off
chcp 65001 > nul
setlocal enabledelayedexpansion
cd /d "%~dp0"

:: ----------------------------------------------------------------------
:: ZIP未解凍 / 一時フォルダ実行検知ガード
:: ----------------------------------------------------------------------
echo "%~dp0" | findstr /i "\\AppData\\Local\\Temp\\ \\Temporary Internet Files\\" > nul
if %errorlevel% equ 0 (
    echo ======================================================================
    echo  【エラー】ZIPファイルが解凍（展開）されていません！
    echo ======================================================================
    echo.
    echo  ZIPファイルの中身を直接開いた状態で実行している可能性があります。
    echo  この状態のままでは正しくインストールできません。
    echo.
    echo  【対処手順】
    echo   1. ダウンロードした ZIP ファイルを「右クリック」してください。
    echo   2. 「すべて展開...」を選択し、通常のフォルダに展開してください。
    echo   3. 展開されたフォルダの中にある install.bat を再度実行してください。
    echo.
    echo ======================================================================
    pause
    exit /b 1
)

if not exist "%~dp0installer\setup.ps1" (
    echo ======================================================================
    echo  【エラー】必要なセットアップファイルが見つかりません！
    echo ======================================================================
    echo.
    echo  ZIPファイルが正しく展開されていないか、ファイルが不足しています。
    echo  ZIPファイルを「すべて展開」してから、フォルダ内の install.bat を実行してください。
    echo.
    echo ======================================================================
    pause
    exit /b 1
)

echo ======================================================================
echo    Deinei System Auto Setup Installer
echo ======================================================================
echo.

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "[Console]::OutputEncoding = [System.Text.Encoding]::UTF8; & '%~dp0installer\setup.ps1'"

echo.
pause
